digraph G {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", nodesep=0.5];
  node [shape=box, style="rounded,filled", fontname="Arial", color="#AAB8D0", fillcolor="#F8FAFC"];
  edge [fontname="Arial", color="#4B638B"];

  employee [label="Employee"];
  frontend [label="Vercel Frontend"];
  api [label="PHP API"];
  db [label="Online MySQL"];
  manager [label="Admin/Manager"];
  warehouse [label="Warehouse"];

  employee -> frontend [label="Submit request"];
  frontend -> api [label="POST /api/requests"];
  api -> db [label="INSERT request + items"];
  db -> api [label="PENDING"];
  api -> frontend [label="request_code"];

  manager -> frontend [label="Approve"];
  frontend -> api [label="POST /api/requests/{id}/review"];
  api -> db [label="UPDATE PENDING -> APPROVED"];

  warehouse -> frontend [label="Issue"];
  frontend -> api [label="POST /api/requests/{id}/issue"];
  api -> db [label="BEGIN + SELECT FOR UPDATE"];
  api -> db [label="INSERT transaction + deduct stock"];
  api -> db [label="UPDATE request -> ISSUED + COMMIT"];
  db -> api [label="transaction reference"];
  api -> frontend [label="success"];
}
