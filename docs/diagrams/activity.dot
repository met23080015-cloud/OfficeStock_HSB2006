digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Arial", nodesep=0.28, ranksep=0.32, margin=0.04, ratio=compress];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#AAB8D0", fontname="Arial", fontsize=9, margin="0.10,0.06"];
  edge [color="#4B638B", fontname="Arial", fontsize=8];

  start [shape=circle,label="",width=.18,height=.18,fillcolor="#3157D5",color="#3157D5"];
  create [label="Employee creates request"];
  pending [label="Store PENDING"];
  review [label="Manager reviews"];
  dec [shape=diamond,label="Approve?",width=1.0,height=.55];
  reject [label="REJECTED\nreason stored", fillcolor="#FFF0EE"];
  approved [label="APPROVED", fillcolor="#ECFDF3"];
  wh [label="Warehouse opens request"];
  stock [shape=diamond,label="Enough stock?",width=1.2,height=.6];
  rollback [label="Rollback\nno deduction", fillcolor="#FFF0EE"];
  issue [label="Transaction + row locks\nDeduct all items"];
  issued [label="ISSUED + history saved", fillcolor="#ECFDF3"];
  end [shape=doublecircle,label="",width=.18,height=.18,fillcolor="#3157D5",color="#3157D5"];

  start->create->pending->review->dec;
  dec->reject [label="No"];
  reject->end;
  dec->approved [label="Yes"];
  approved->wh->stock;
  stock->rollback [label="No"];
  rollback->end;
  stock->issue [label="Yes"];
  issue->issued->end;
}
